@comment{
  Add your publications below in BibTeX format and they will render automatically,
  grouped by year, on the /publications/ page.

  Useful al-folio extras you can add to any entry:
    selected   = {true}              % show on the front page "selected papers" list
    abbr       = {JGR}               % small venue badge on the left
    pdf        = {paper.pdf}         % file in assets/pdf/  (or a full URL)
    code       = {https://github.com/...}
    html       = {https://doi.org/...}
    bibtex_show= {true}              % show a "Bib" button with the raw entry
    preview    = {figure.png}        % thumbnail in assets/img/publication_preview/
    abstract   = {...}               % expandable abstract

  Tip: keep your own name consistent (e.g. "Seo, Min-Seong") and list it in
  _config.yml -> scholar.last_name / first_name so it gets bold/underlined.
}

@article{seo2026example,
  abbr      = {Example},
  title     = {Replace this with the title of your first paper},
  author    = {Seo, Min-Seong and Coauthor, A.},
  journal   = {Journal Name},
  year      = {2026},
  selected  = {true},
  % pdf     = {your_paper.pdf},
  % html    = {https://doi.org/...},
  % code    = {https://github.com/seismoseo/...},
  abstract  = {A one-paragraph summary of the work. This text appears when a reader
               clicks the "Abs" button. Delete this placeholder entry once you add
               your real publications.}
}
